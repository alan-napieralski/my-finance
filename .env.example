# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# API Key for n8n webhook authentication
NUXT_API_KEY=your-secure-api-key-here

# Postgres connection string (server-side only)
# Prefer NUXT_DATABASE_URL (Nuxt runtimeConfig), but DATABASE_URL is also supported.
NUXT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_finance
# DATABASE_URL=

# Optional: enable mock finance data when no entries exist in the server store.
# Never used in production.
# MY_FINANCE_USE_MOCK_DATA=true

# Local Postgres container defaults (used by docker-compose.yml). Copy into .env for local dev.
POSTGRES_DB=my_finance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
