# Copy to infra/.env and fill in values. Do NOT commit infra/.env.
# This file includes only the variables required for `infra/compose.yml` (app + postgres) to run.

# --- App database (my-finance) ---
APP_DB_NAME=my_finance
APP_DB_USER=my_finance_app
APP_DB_PASSWORD=change-me

# --- Nuxt runtime config (server-side) ---
# Used by /api/finance/ingest to authenticate inbound calls from external automations (e.g., n8n).
# Generate with: openssl rand -hex 32
NUXT_API_KEY=change-me
